{
    "name": "kinetis-benchmarks/slim-frankenphp",
    "description": "The Slim 4 benchmark app served by FrankenPHP in worker mode",
    "type": "project",
    "require": {
        "php": "^8.4",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
