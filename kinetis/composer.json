{
    "name": "kinetis/tfbench-kinetis",
    "description": "Kinetis's own entry in the cross-framework TechEmpower-methodology benchmark suite under benchmarks/.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/framework": "^1.17",
        "kinetis/persistence": "^1.10",
        "kinetis/query-builder": "^1.2",
        "league/plates": "^3.6",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "vimeo/psalm": "^6.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
