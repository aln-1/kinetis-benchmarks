{
    "name": "kinetis-benchmarks/spiral-roadrunner",
    "description": "RoadRunner's own framework, minimal entry for the Kinetis benchmark comparison — raw SQL access via spiral/cycle-bridge's DatabaseBootloader, no ORM entities.",
    "type": "project",
    "require": {
        "php": "^8.4",
        "spiral/framework": "^3.15",
        "spiral/cycle-bridge": "^2.11",
        "spiral/roadrunner-bridge": "^3.8",
        "spiral/nyholm-bridge": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "spiral/composer-publish-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
